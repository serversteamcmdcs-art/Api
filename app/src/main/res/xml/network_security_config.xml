<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Только HTTPS: открытый трафик запрещён для всех доменов -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
